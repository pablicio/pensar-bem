       IDENTIFICATION DIVISION.
       PROGRAM-ID. DATAS2.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-ABERTURA             PIC 9(8)      VALUE 19870315.
       01  WS-CONVERSAO            PIC 9(8)      VALUE 20270306.
       01  WS-DIAS                 PIC 9(7).
       01  WS-DATA-NOVA            PIC 9(8).
       01  WS-DIA-SEMANA           PIC 9.
       01  WS-NOMES-DADOS          PIC X(21)
                                   VALUE "DOMSEGTERQUAQUISEXSAB".
       01  WS-NOMES REDEFINES WS-NOMES-DADOS.
           05  WS-NOME-DIA         PIC X(3) OCCURS 7 TIMES.
       PROCEDURE DIVISION.
           COMPUTE WS-DIAS = FUNCTION INTEGER-OF-DATE(WS-CONVERSAO)
                           - FUNCTION INTEGER-OF-DATE(WS-ABERTURA)
           DISPLAY "DIAS ENTRE ABERTURA E CONVERSAO: " WS-DIAS
           COMPUTE WS-DATA-NOVA = FUNCTION DATE-OF-INTEGER(
                   FUNCTION INTEGER-OF-DATE(WS-CONVERSAO) + 30)
           DISPLAY "CONVERSAO + 30 DIAS: " WS-DATA-NOVA
           COMPUTE WS-DIA-SEMANA = FUNCTION MOD(
                   FUNCTION INTEGER-OF-DATE(WS-CONVERSAO), 7)
           DISPLAY "DIA DA SEMANA DA CONVERSAO: "
                   WS-NOME-DIA(WS-DIA-SEMANA + 1)
           GOBACK.
